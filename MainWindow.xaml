<Window x:Class="YtDlpGui.MainWindow"
        x:Name="MainWindowRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="yt-dlp GUI"
        Height="620" Width="780"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinHeight="520" MinWidth="640">

    <Window.Resources>

        <Style x:Key="CustomTitleBar" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1e0a0a" Offset="0"/>
                        <GradientStop Color="#130808" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#e5e7eb"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#d4d4d4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2a1515"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCloseBtn" TargetType="Button" BasedOn="{StaticResource WinBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#dc2626"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MainInputStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="#f5f5f5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CaretBrush" Value="#ef4444"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style x:Key="RunButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="10"
                                Padding="22,0,22,0"
                                Height="44">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#ef4444" Offset="0"/>
                                    <GradientStop Color="#dc2626" Offset="0.5"/>
                                    <GradientStop Color="#991b1b" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#dc2626" BlurRadius="22" ShadowDepth="2" Opacity="0.5"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Width="14" Height="14"
                                      Data="M5 3 L19 12 L5 21 Z"
                                      Fill="White" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="2"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#ef4444" BlurRadius="28" ShadowDepth="3" Opacity="0.7"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#e5e5e5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="12,5,12,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                Background="#151515"
                                BorderBrush="#2a1818"
                                BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2a1010"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#5a1a1a"/>
                                <Setter Property="Foreground" Value="#fecaca"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Border x:Name="RootBorder">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#100a0a" Offset="0"/>
                    <GradientStop Color="#0a0606" Offset="0.5"/>
                    <GradientStop Color="#140a0a" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Ellipse Width="560" Height="560" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-200,-230,0,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.5,0.5">
                            <GradientStop Color="#8CDC2626" Offset="0"/>
                            <GradientStop Color="#2EDC2626" Offset="0.4"/>
                            <GradientStop Color="Transparent" Offset="0.72"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <BlurEffect Radius="38"/>
                    </Ellipse.Effect>
                </Ellipse>

                <Ellipse Width="620" Height="620" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-240,-300">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.5,0.5">
                            <GradientStop Color="#80991B1B" Offset="0"/>
                            <GradientStop Color="#387F1D1D" Offset="0.45"/>
                            <GradientStop Color="Transparent" Offset="0.75"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <BlurEffect Radius="42"/>
                    </Ellipse.Effect>
                </Ellipse>

                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#D91A0F0F" Offset="0"/>
                            <GradientStop Color="#EB0D0707" Offset="0.5"/>
                            <GradientStop Color="#E1180D0D" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <BlurEffect Radius="2" KernelType="Gaussian"/>
                    </Border.Effect>
                    <Border.Opacity>0.01</Border.Opacity>
                </Border>

                <!-- Main Content -->
                <Grid Margin="28,22,28,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Hero -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,4,0,18">
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       FontFamily="Segoe UI">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#f87171" Offset="0"/>
                                        <GradientStop Color="#ef4444" Offset="0.35"/>
                                        <GradientStop Color="#dc2626" Offset="0.7"/>
                                        <GradientStop Color="#b91c1c" Offset="1"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                                YouTube Downloader
                            </TextBlock>
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="#a3a3a3"
                                       FontSize="12.5"
                                       FontFamily="Segoe UI"
                                       Margin="0,6,0,0">
                                Paste a link, press Enter, and let yt-dlp do the rest.
                            </TextBlock>
                        </StackPanel>

                        <!-- Input -->
                        <Grid Grid.Row="1">
                            <Border CornerRadius="14" x:Name="InputBorder">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#612A0E0E" Offset="0"/>
                                        <GradientStop Color="#8C1E0A0A" Offset="0.6"/>
                                        <GradientStop Color="#99150606" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#dc2626" Opacity="0.28"/>
                                </Border.BorderBrush>
                                <Border.BorderThickness>
                                    <Thickness>1</Thickness>
                                </Border.BorderThickness>
                                <Border.Effect>
                                    <BlurEffect Radius="20"/>
                                </Border.Effect>
                                <Border.Opacity>0.98</Border.Opacity>
                            </Border>
                            <Grid Margin="0,0,0,0" Height="56">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Margin="16,0,10,0">
                                    <TextBox x:Name="UrlInput"
                                             FontFamily="Segoe UI"
                                             VerticalAlignment="Center"
                                             KeyDown="UrlInput_KeyDown">
                                        <TextBox.Resources>
                                            <VisualBrush x:Key="CueBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="Paste YouTube / video link here and press Enter..."
                                                               Foreground="#555555"
                                                               FontStyle="Italic"
                                                               FontFamily="Segoe UI"
                                                               FontSize="14.5"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </TextBox.Resources>
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource MainInputStyle}">
                                                <Style.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                    </Style>
                                                </Style.Resources>
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Background" Value="{StaticResource CueBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>
                                <Button x:Name="RunBtn"
                                        Grid.Column="1"
                                        Margin="0,6,6,6"
                                        Style="{StaticResource RunButtonStyle}"
                                        Content="Download"
                                        Click="RunBtn_Click"/>
                            </Grid>
                        </Grid>

                        <!-- Status Row -->
                        <Grid Grid.Row="2" Margin="2,16,4,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" Fill="#525252">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#525252"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=MainWindowRoot, Path=Tag}" Value="running">
                                                    <Setter Property="Fill" Value="#22c55e"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#22c55e" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=MainWindowRoot, Path=Tag}" Value="success">
                                                    <Setter Property="Fill" Value="#22c55e"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=MainWindowRoot, Path=Tag}" Value="error">
                                                    <Setter Property="Fill" Value="#dc2626"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock x:Name="StatusText"
                                           Margin="8,0,0,0"
                                           Text="Ready"
                                           Foreground="#b5b5b5"
                                           FontSize="12.5"
                                           FontFamily="Segoe UI"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource GhostBtn}" Content="Clear Output" Click="ClearBtn_Click"/>
                        </Grid>

                        <!-- Output -->
                        <Grid Grid.Row="3" Margin="0,0,0,0">
                            <Border CornerRadius="14">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#C7100A0A" Offset="0"/>
                                        <GradientStop Color="#99180D0D" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#dc2626" Opacity="0.16"/>
                                </Border.BorderBrush>
                                <Border.BorderThickness>
                                    <Thickness>1</Thickness>
                                </Border.BorderThickness>
                                <Border.Effect>
                                    <BlurEffect Radius="18"/>
                                </Border.Effect>
                                <Border.Opacity>0.98</Border.Opacity>
                            </Border>
                            <RichTextBox x:Name="OutputBox"
                                         Margin="14,12,14,12"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#e5e5e5"
                                         IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled"
                                         FontFamily="Consolas, Cascadia Code, Courier New"
                                         FontSize="12.2"
                                         Padding="4,2,4,2">
                                <RichTextBox.Resources>
                                    <Style TargetType="ScrollBar">
                                        <Setter Property="Width" Value="8"/>
                                        <Setter Property="MinWidth" Value="8"/>
                                    </Style>
                                </RichTextBox.Resources>
                            </RichTextBox>
                        </Grid>

                        <!-- Hint -->
                        <TextBlock Grid.Row="4"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="#606060"
                                   FontSize="11"
                                   FontFamily="Segoe UI"
                                   Text="runs yt-dlp.exe from the same folder (or parent folder) · output files appear beside yt-dlp.exe"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
</Window>
